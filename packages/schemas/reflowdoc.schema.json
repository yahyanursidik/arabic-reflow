          "type": "integer"
        },
        "bidi_warning": {
          "default": false,
          "title": "Bidi Warning",
          "type": "boolean"
        }
      },
      "required": [
        "score"
      ],
      "title": "ArabicIntegrity",
      "type": "object"
    },

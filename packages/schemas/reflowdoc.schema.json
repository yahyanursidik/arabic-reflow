          "title": "Code",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ReflowWarning",
      "type": "object"
    },
    "Resource": {
      "description": "A binary resource referenced by blocks (image, font, table fallback).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "e.g. 'image' or 'font'",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "source_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page"
        },
        "content": {
          "anyOf": [
            {
              "format": "binary",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Encoded payload (base64 in JSON). MVP: images are carried inline so a ReflowDoc JSON is self-contained.",
          "title": "Content"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ScriptClass": {
      "description": "Script classification. Script matters more than natural language (PRD 8.6).",
      "enum": [
        "Arabic",
        "Latin",
        "Mixed",
        "Numeric",
        "Neutral"
      ],
      "title": "ScriptClass",
      "type": "string"
    },
    "SourceRef": {
      "description": "Extraction provenance, kept for diagnostics only.\n\nCoordinates are PDF points and must never be used by renderers for layout.",
      "properties": {
        "page": {
          "description": "1-based source page number",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[x0, y0, x1, y1] in PDF points, diagnostics only",
          "title": "Bbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SpanNode": {
      "description": "An inline span with its own language/script/direction (mixed-direction text).",
      "properties": {
        "type": {
          "const": "span",
          "default": "span",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "default": "unknown",
          "title": "Lang",
          "type": "string"
        },
        "script": {
          "$ref": "#/$defs/ScriptClass",
          "default": "Neutral"
        },
        "dir": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "title": "Transformations",
          "type": "array"
        },
        "arabic_integrity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArabicIntegrity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "SpanNode",
      "type": "object"
    },
    "TableBlock": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lang": {
          "default": "unknown",
          "title": "Lang",
          "type": "string"
        },
        "script": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dir": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "modified_by_user": {
          "default": false,
          "description": "True only when a human explicitly edited the content",
          "title": "Modified By User",
          "type": "boolean"
        },
        "arabic_integrity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArabicIntegrity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arabic diagnostic metadata when the block carries Arabic"
        },
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/TableCell"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "fallback_resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Resource Id"
        }
      },
      "required": [
        "id"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "TableCell": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "dir": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TextNode": {
      "description": "A run of text in the block's primary language/direction.",
      "properties": {
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original extraction when a transformation was applied",
          "title": "Source Text"
        },
        "transformations": {
          "description": "Applied transformations, e.g. ['dehyphenation']",
          "items": {
            "type": "string"
          },
          "title": "Transformations",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextNode",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/DocumentMetadata"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/Chapter"
      },
      "title": "Chapters",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "title": "Resources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ReflowWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "ReflowDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reflow.dev/schemas/reflowdoc-0.1.json"
}

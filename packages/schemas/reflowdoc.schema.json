        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "presentation_forms_detected": {
          "default": false,
          "title": "Presentation Forms Detected",
          "type": "boolean"
        },
